# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Telegram Chat ID (channel: @channelname, group: use @userinfobot)
TELEGRAM_CHAT_ID=@YourChannel

# Admin chat ID for QR codes (your personal Telegram chat ID)
TELEGRAM_ADMIN_CHAT_ID=

# WhatsApp group name (exact name as it appears in WhatsApp)
WHATSAPP_GROUP_NAME=Your Group Name

# Port for health check (Railway sets this automatically)
PORT=3000
